rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección de usuarios (login)
    match /usuarios/{document=**} {
      allow read, write: if true;
    }
    // Reglas para la colección de clientes
    match /clientes/{document=**} {
      allow read, write: if true; 
    }
    // Reglas para la colección de plantillas y su subcolección items
    match /plantillas/{plantillaId} {
      allow read, write: if true;
      match /items/{itemId} {
        allow read, write: if true;
      }
    }
    // Regla general para el resto (permitir si está autenticado o antes del 2035)
    match /{document=**} {
      allow read, write: if request.auth != null || request.time < timestamp.date(2035, 1, 1);
    }
  }
}